<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&amp;family=Caveat:wght@500;600&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap" rel="stylesheet">
<script src="./image-slot.js"></script>
<style>
  * { box-sizing: border-box; }
  body { margin: 0; font-family: Figtree, "Helvetica Neue", Helvetica, sans-serif; background: #ffffff; color: #0b1220; -webkit-font-smoothing: antialiased; }
  a { color: #1d4ed8; text-decoration: none; }
  a:hover { color: #0b1220; }
</style>
</helmet>

<div style="width:100%;overflow-x:hidden">

  <div style="position:relative;overflow:hidden;background:radial-gradient(ellipse 70% 90% at 78% 45%,#d4e5fc 0%,rgba(212,229,252,0) 70%),linear-gradient(100deg,#ffffff 0%,#f7faff 28%,#e3eefd 60%,#d6e6fb 100%);box-shadow:inset 0 -1px 0 #dfe8f6;min-height:{{ heroMinH }}">
    <sc-if value="{{ heroWide }}" hint-placeholder-val="{{ true }}">
      <div style="position:absolute;top:84px;bottom:0;right:0;width:{{ heroImgW }};z-index:0;-webkit-mask-image:linear-gradient(90deg,transparent 0%,#000 3%);mask-image:linear-gradient(90deg,transparent 0%,#000 3%)">
        <image-slot id="fdc-hero-3" shape="rect" radius="0" src="./assets/hero-3x2.png" placeholder="hero photo 3:2 (1536×1024)"></image-slot>
      </div>
    </sc-if>
    <header style="position:relative;z-index:2;max-width:1180px;margin:0 auto;padding:22px 28px;display:flex;align-items:center;gap:20px">
      <div style="font-size:19px;font-weight:800;letter-spacing:-0.02em;white-space:nowrap">First Dollar Co.</div>
      <nav style="display:flex;gap:20px;font-size:14.5px;font-weight:600;color:#3c4a60;white-space:nowrap">
        <a href="#top" style="color:#0b1220">Home</a>
        <a href="#kit" style="color:#3c4a60">What's Included</a>
        <a href="#course" style="color:#3c4a60">Free Course</a>
        <a href="#faq" style="color:#3c4a60">FAQ</a>
      </nav>
      <div style="flex:1;min-width:0"></div>
      <div style="display:flex;align-items:center;gap:10px;white-space:nowrap;flex-shrink:1;min-width:0;overflow:hidden">
        <div style="width:32px;height:22px;border-radius:5px;background:#ff0033;display:flex;align-items:center;justify-content:center">
          <div style="width:0;height:0;border-left:7px solid #fff;border-top:4.5px solid transparent;border-bottom:4.5px solid transparent;margin-left:2px"></div>
        </div>
        <div style="line-height:1.25;min-width:0;overflow:hidden">
          <div style="font-size:13.5px;font-weight:700;overflow:hidden;text-overflow:ellipsis">145K+ on YouTube</div>
          <div style="font-size:11.5px;color:#61708c;overflow:hidden;text-overflow:ellipsis">Helping beginners make their first $1 online</div>
        </div>
      </div>
      <a href="#kit" style="background:#1d6ef5;color:#fff;font-size:14px;font-weight:700;padding:11px 18px;border-radius:9px;box-shadow:0 6px 16px rgba(29,110,245,0.28);white-space:nowrap;flex:none" style-hover="background:#155cd6;color:#fff">Get the $5 Kit →</a>
    </header>

    <div id="top" style="position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:8px 28px 0">
      <div ref="{{ textRef }}" style="padding:26px 0 44px;max-width:{{ heroTextMax }};min-width:0">
        <div style="display:inline-block;background:#d9e8ff;color:#1552c7;font-size:11.5px;font-weight:800;letter-spacing:0.12em;padding:7px 12px;border-radius:7px">$5 BEGINNER ROADMAP</div>
        <h1 style="margin:16px 0 0;font-size:clamp(34px,4.4vw,68px);line-height:0.98;font-weight:900;letter-spacing:-0.035em;text-wrap:pretty">Make Your first<br><span style="color: rgb(29, 110, 245);">$1 online.</span></h1>
        <p style="margin:20px 0 0;font-size:clamp(14px,1.25vw,17px);line-height:1.5;color:#2b3a52;max-width:430px;text-wrap:pretty">A calm, practical path for people with no audience. Go from a blank page to a simple digital product and one honest first-sale attempt.</p>
        <p style="margin:12px 0 0;font-size:13px;line-height:1.5;color:#7a89a3">Not a get-rich system. No income claims. Just the next useful step.</p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:24px">
          <a href="#kit" style="background:#1d6ef5;color:#fff;font-size:clamp(12px,1.1vw,15.5px);font-weight:700;padding:clamp(11px,1vw,15px) clamp(15px,1.6vw,24px);border-radius:11px;box-shadow:0 10px 24px rgba(29,110,245,0.3);white-space:nowrap" style-hover="background:#155cd6;color:#fff">Get the $5 Kit →</a>
          <a href="https://www.youtube.com/playlist?list=PLRcOv45N0DG8" target="_blank" rel="noopener" style="background:#fff;color:#0b1220;font-size:clamp(12px,1.1vw,15.5px);font-weight:700;padding:clamp(8px,0.8vw,12px) clamp(12px,1.4vw,22px);border-radius:11px;border:1px solid #d7e2f5;display:flex;align-items:center;gap:8px;white-space:nowrap" style-hover="border-color:#1d6ef5;color:#0b1220">
            <span style="flex:none;width:clamp(20px,1.8vw,26px);height:clamp(20px,1.8vw,26px);border-radius:50%;background:#1d6ef5;display:flex;align-items:center;justify-content:center">
              <span style="width:0;height:0;border-left:8px solid #fff;border-top:5px solid transparent;border-bottom:5px solid transparent;margin-left:2px"></span>
            </span>
            Watch the free course
          </a>
        </div>
        <sc-if value="{{ showSocialProof }}" hint-placeholder-val="{{ true }}">
          <div style="display:flex;align-items:center;gap:14px;margin-top:30px">
            <div style="display:flex">
              <div style="width:38px;height:38px;border-radius:50%;border:2px solid #fff;background:#cddcf3;color:#476190;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center">JM</div>
              <div style="width:38px;height:38px;border-radius:50%;border:2px solid #fff;background:#dbe6f7;color:#476190;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-left:-12px">AK</div>
              <div style="width:38px;height:38px;border-radius:50%;border:2px solid #fff;background:#c6d6ef;color:#476190;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-left:-12px">TR</div>
            </div>
            <div>
              <div style="color:#f5a623;font-size:14px;letter-spacing:1px">★★★★★</div>
              <div style="font-size:13.5px;font-weight:700;margin-top:2px">1,200+ beginners already got the kit</div>
              <div style="font-size:12.5px;color:#7a89a3">“Simple, clear and actually actionable.”</div>
            </div>
          </div>
        </sc-if>
      </div>
      <sc-if value="{{ heroNarrow }}" hint-placeholder-val="{{ false }}">
        <div style="position:relative;aspect-ratio:3 / 2;margin:0 -28px">
          <image-slot id="fdc-hero-3" shape="rect" radius="0" src="./assets/hero-3x2.png" placeholder="hero photo 3:2 (1536×1024)"></image-slot>
        </div>
      </sc-if>
    </div>
  </div>

  <sc-if value="{{ showComparison }}" hint-placeholder-val="{{ true }}">
    <div style="max-width:1180px;margin:0 auto;padding:36px 28px 0;display:grid;grid-template-columns:minmax(0,1.15fr) 44px minmax(0,1.3fr) minmax(0,0.85fr);gap:14px;align-items:stretch">
      <div style="background:#f4f6fa;border:1px solid #e6eaf2;border-radius:14px;padding:22px">
        <div style="width:44px;height:44px;border-radius:50%;background:#fff;border:1px solid #e2e7f0;display:flex;align-items:center;justify-content:center;font-size:19px;color:#4a5a75">↻</div>
        <div style="margin-top:16px;font-size:14.5px;font-weight:700;color:#1d6ef5">The usual loop</div>
        <div style="font-size:17px;font-weight:800;margin-top:3px">More saving. Nothing for sale.</div>
        <div style="margin-top:14px;display:grid;gap:9px;font-size:13.5px;color:#4a5a75">
          <div style="display:flex;gap:9px"><span style="color:#e2554f;font-weight:700">✕</span>Watch another video, then another.</div>
          <div style="display:flex;gap:9px"><span style="color:#e2554f;font-weight:700">✕</span>Buy a course you do not finish.</div>
          <div style="display:flex;gap:9px"><span style="color:#e2554f;font-weight:700">✕</span>Wait until it feels “ready.”</div>
          <div style="display:flex;gap:9px"><span style="color:#e2554f;font-weight:700">✕</span>Still no product. Still no attempt.</div>
        </div>
      </div>
      <div style="display:flex;align-items:center;justify-content:center;font-size:22px;color:#93a2ba">→</div>
      <div style="background:#eaf2ff;border:1px solid #d3e3fd;border-radius:14px;padding:22px">
        <div style="width:44px;height:44px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;color:#1d6ef5">⚡</div>
        <div style="margin-top:16px;font-size:14.5px;font-weight:700;color:#1d6ef5">A clearer path</div>
        <div style="font-size:17px;font-weight:800;margin-top:3px">One product. One try.</div>
        <div style="margin-top:14px;display:grid;gap:9px;font-size:13.5px;color:#26354d">
          <div style="display:flex;gap:9px"><span style="color:#1d6ef5;font-weight:700">✓</span>Pick one problem you can already help with.</div>
          <div style="display:flex;gap:9px"><span style="color:#1d6ef5;font-weight:700">✓</span>Make a small digital product you can finish.</div>
          <div style="display:flex;gap:9px"><span style="color:#1d6ef5;font-weight:700">✓</span>Put a real price on it.</div>
          <div style="display:flex;gap:9px"><span style="color:#1d6ef5;font-weight:700">✓</span>Attempt a first sale, then learn from it.</div>
        </div>
      </div>
      <div style="background:#fff;border:1px solid #e6eaf2;border-radius:14px;padding:22px;display:flex;flex-direction:column;justify-content:space-between">
        <div>
          <div style="font-size:26px;line-height:0.6;color:#c3cede;font-weight:800">“</div>
          <div style="margin-top:8px;font-size:14.5px;line-height:1.5;color:#26354d">This kit gave me direction and finally got me to take <strong>action. I made my first sale 12 days later.</strong>”</div>
        </div>
        <div style="display:flex;align-items:center;gap:10px;margin-top:18px">
          <div style="width:32px;height:32px;border-radius:50%;background:#dbe6f7;color:#476190;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center">RT</div>
          <div style="line-height:1.3">
            <div style="font-size:13px;font-weight:700">Ryan T.</div>
            <div style="font-size:12px;color:#7a89a3">Student</div>
          </div>
        </div>
      </div>
    </div>
  </sc-if>

  <div style="max-width:1180px;margin:0 auto;padding:52px 28px 0;text-align:center">
    <h2 style="margin:0;font-size:34px;font-weight:900;letter-spacing:-0.028em;text-wrap:pretty">Seven steps. None of them are “build a brand first.”</h2>
    <p style="margin:10px 0 0;font-size:15.5px;color:#61708c">A simple, repeatable process to go from idea to your first sale.</p>
  </div>

  <div style="max-width:1180px;margin:0 auto;padding:26px 28px 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px">
    <div style="background:#fbfcfe;border:1px solid #e6eaf2;border-radius:14px;padding:22px;display:flex;gap:16px">
      <div style="flex:none;width:44px;height:44px;border-radius:11px;background:#e6efff;display:flex;align-items:center;justify-content:center"><span style="width:14px;height:14px;border:2.5px solid #1d6ef5;border-radius:50%"></span></div>
      <div>
        <div style="font-size:13px;font-weight:700;color:#1d6ef5">01 · Find</div>
        <div style="font-size:16.5px;font-weight:800;margin-top:4px;line-height:1.25">Find a problem<br>you can already help with</div>
        <div style="font-size:13.5px;color:#61708c;line-height:1.5;margin-top:10px">Skip the hunt for a secret niche. Start with something you can explain to one person.</div>
      </div>
    </div>
    <div style="background:#fbfcfe;border:1px solid #e6eaf2;border-radius:14px;padding:22px;display:flex;gap:16px">
      <div style="flex:none;width:44px;height:44px;border-radius:11px;background:#e6efff;display:flex;align-items:center;justify-content:center"><span style="width:14px;height:14px;border:2.5px solid #1d6ef5;border-radius:3px"></span></div>
      <div>
        <div style="font-size:13px;font-weight:700;color:#1d6ef5">02 · Choose</div>
        <div style="font-size:16.5px;font-weight:800;margin-top:4px;line-height:1.25">Choose one simple<br>product type</div>
        <div style="font-size:13.5px;color:#61708c;line-height:1.5;margin-top:10px">A short guide, a checklist, a template, or a prompt pack. One format. Small enough to finish.</div>
      </div>
    </div>
    <div style="background:#fbfcfe;border:1px solid #e6eaf2;border-radius:14px;padding:22px;display:flex;gap:16px">
      <div style="flex:none;width:44px;height:44px;border-radius:11px;background:#e6efff;display:flex;align-items:center;justify-content:center"><span style="width:12px;height:16px;border:2.5px solid #1d6ef5;border-radius:2px"></span></div>
      <div>
        <div style="font-size:13px;font-weight:700;color:#1d6ef5">03 · Offer</div>
        <div style="font-size:16.5px;font-weight:800;margin-top:4px;line-height:1.25">Write a one-sentence offer</div>
        <div style="font-size:13.5px;color:#61708c;line-height:1.5;margin-top:10px">Who it is for, what they get, and what it helps them do. If you cannot say it in one line, it's still too big.</div>
      </div>
    </div>
    <div style="background:#fbfcfe;border:1px solid #e6eaf2;border-radius:14px;padding:22px;display:flex;gap:16px">
      <div style="flex:none;width:44px;height:44px;border-radius:11px;background:#e6efff;display:flex;align-items:center;justify-content:center"><span style="width:16px;height:16px;background:#1d6ef5;clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)"></span></div>
      <div>
        <div style="font-size:13px;font-weight:700;color:#1d6ef5">04 · Build</div>
        <div style="font-size:16.5px;font-weight:800;margin-top:4px;line-height:1.25">Make a first version<br>you can finish</div>
        <div style="font-size:13.5px;color:#61708c;line-height:1.5;margin-top:10px">Useful beats polished. Use free tools. Ship a version you would be willing to sell this week.</div>
      </div>
    </div>
    <div style="background:#fbfcfe;border:1px solid #e6eaf2;border-radius:14px;padding:22px;display:flex;gap:16px">
      <div style="flex:none;width:44px;height:44px;border-radius:11px;background:#e6efff;display:flex;align-items:center;justify-content:center"><span style="width:15px;height:15px;border:2.5px solid #1d6ef5;transform:rotate(45deg);border-radius:3px"></span></div>
      <div>
        <div style="font-size:13px;font-weight:700;color:#1d6ef5">05 · Price</div>
        <div style="font-size:16.5px;font-weight:800;margin-top:4px;line-height:1.25">Set a small, honest price</div>
        <div style="font-size:13.5px;color:#61708c;line-height:1.5;margin-top:10px">The point is a real checkout, not a perfect offer. A small price makes the first attempt easier to make.</div>
      </div>
    </div>
    <div style="background:#fbfcfe;border:1px solid #e6eaf2;border-radius:14px;padding:22px;display:flex;gap:16px">
      <div style="flex:none;width:44px;height:44px;border-radius:11px;background:#e6efff;display:flex;align-items:center;justify-content:center"><span style="width:16px;height:16px;background:#1d6ef5;clip-path:polygon(0 0,100% 50%,0 100%,28% 50%)"></span></div>
      <div>
        <div style="font-size:13px;font-weight:700;color:#1d6ef5">06 · Launch</div>
        <div style="font-size:16.5px;font-weight:800;margin-top:4px;line-height:1.25">Put it in front of people</div>
        <div style="font-size:13.5px;color:#61708c;line-height:1.5;margin-top:10px">A link, a post, a few conversations. You are collecting a first-sale attempt, not building a company overnight.</div>
      </div>
    </div>
    <div style="background:#fbfcfe;border:1px solid #e6eaf2;border-radius:14px;padding:22px;display:flex;gap:16px">
      <div style="flex:none;width:44px;height:44px;border-radius:11px;background:#e6efff;display:flex;align-items:flex-end;justify-content:center;gap:2px;padding-bottom:14px">
        <span style="width:3px;height:8px;background:#1d6ef5"></span>
        <span style="width:3px;height:13px;background:#1d6ef5"></span>
        <span style="width:3px;height:17px;background:#1d6ef5"></span>
      </div>
      <div>
        <div style="font-size:13px;font-weight:700;color:#1d6ef5">07 · Improve</div>
        <div style="font-size:16.5px;font-weight:800;margin-top:4px;line-height:1.25">Keep what worked,<br>drop what did not</div>
        <div style="font-size:13.5px;color:#61708c;line-height:1.5;margin-top:10px">Look at what people asked, ignored, or bought. Then make the next version smaller and clearer.</div>
      </div>
    </div>
  </div>

  <div id="kit" style="max-width:1180px;margin:0 auto;padding:40px 28px 0;display:grid;grid-template-columns:minmax(0,1.9fr) minmax(0,1fr);gap:14px;align-items:stretch">
    <div style="background:#eaf2ff;border:1px solid #d3e3fd;border-radius:16px;padding:30px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,0.78fr);gap:26px">
      <div>
        <div style="font-size:11.5px;font-weight:800;letter-spacing:0.16em;color:#1552c7">WHAT YOU GET</div>
        <h3 style="margin:10px 0 0;font-size:31px;font-weight:900;letter-spacing:-0.03em">The $5 kit</h3>
        <p style="margin:10px 0 0;font-size:14.5px;line-height:1.5;color:#2b3a52">Short documents you can use, not a 14-hour content dump. Keep them next to you while you make the first version.</p>
        <div style="margin-top:22px;display:grid;gap:11px;font-size:13.5px;color:#26354d">
          <div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:19px;height:19px;border-radius:50%;background:#1d6ef5;color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center">✓</span><span><strong>The Guide</strong> — step-by-step written roadmap</span></div>
          <div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:19px;height:19px;border-radius:50%;background:#1d6ef5;color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center">✓</span><span><strong>Offer Worksheet</strong> — prompts for a clear, sellable offer</span></div>
          <div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:19px;height:19px;border-radius:50%;background:#1d6ef5;color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center">✓</span><span><strong>Validation Checklist</strong> — test the idea before you overbuild</span></div>
          <div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:19px;height:19px;border-radius:50%;background:#1d6ef5;color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center">✓</span><span><strong>AI Prompt Pack</strong> — copy-paste prompts for the idea, product and listing</span></div>
          <div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:19px;height:19px;border-radius:50%;background:#1d6ef5;color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center">✓</span><span><strong>Launch Plan</strong> — day-by-day moves for a first-sale attempt</span></div>
          <div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:19px;height:19px;border-radius:50%;background:#1d6ef5;color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center">✓</span><span><strong>7-Step Roadmap</strong> — one page you can keep next to you</span></div>
        </div>
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:26px">
          <a href="#kit" style="background:#1d6ef5;color:#fff;font-size:15px;font-weight:700;padding:14px 22px;border-radius:10px;box-shadow:0 8px 20px rgba(29,110,245,0.28)" style-hover="background:#155cd6;color:#fff">Get the $5 Kit →</a>
          <span style="font-size:13px;color:#61708c">One-time payment. You keep it.</span>
        </div>
      </div>
      <div style="display:flex;align-items:center;justify-content:flex-end;overflow:visible">
        <img src="./assets/kit-mockup-cut.png" alt="The $5 kit — guide, offer worksheet, launch plan and checklists" style="width:118%;max-width:none;object-fit:contain;display:block;transform:translateX(7%)">
      </div>
    </div><div id="course" style="background:#fff;border:1px solid #e6eaf2;border-radius:16px;padding:24px;display:flex;flex-direction:column">
        <div style="width:36px;height:26px;border-radius:6px;background:#ff0033;display:flex;align-items:center;justify-content:center">
          <div style="width:0;height:0;border-left:9px solid #fff;border-top:6px solid transparent;border-bottom:6px solid transparent;margin-left:2px"></div>
        </div>
        <div style="font-size:13.5px;color:#61708c;margin-top:14px">Prefer to watch?</div>
        <div style="font-size:20px;font-weight:800;line-height:1.25;margin-top:3px">There is a free course<br>on YouTube.</div>
        <p style="margin:12px 0 0;font-size:13.5px;line-height:1.5;color:#61708c">Use it if you want to see the path first. The $5 kit is the written version you can follow at your own pace, with the worksheets next to you.</p>
        <div style="position:relative;margin-top:18px;height:150px">
          <image-slot id="fdc-video" shape="rounded" radius="10" placeholder="video thumbnail" style="width: 334px; height: 176px"></image-slot>
          <div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:44px;height:44px;border-radius:50%;background:#ff0033;display:flex;align-items:center;justify-content:center;pointer-events:none">
            <div style="width:0;height:0;border-left:13px solid #fff;border-top:8px solid transparent;border-bottom:8px solid transparent;margin-left:3px"></div>
          </div>
        </div>
        
        <div style="flex:1;min-height:10px"></div>
        <div style="font-family:Caveat,cursive;font-size:17px;color:#1b2a44;text-align:right;margin-top:8px">Watch on YouTube ↴</div><a href="https://www.youtube.com/playlist?list=PLRcOv45N0DG8" target="_blank" rel="noopener" style="margin-top:14px;display:block;text-align:center;background:#fff;border:1px solid #d7e2f5;border-radius:10px;padding:13px;font-size:14.5px;font-weight:700;color:#0b1220" style-hover="border-color:#1d6ef5;color:#0b1220">Watch the free course →</a>
      </div>

    <sc-if value="{{ showFreeCourse }}" hint-placeholder-val="{{ true }}">
      
    </sc-if>
  </div>

  <div id="faq" style="max-width:1180px;margin:0 auto;padding:16px 28px 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:14px;align-items:stretch">
    <div style="background:#fbfcfe;border:1px solid #e6eaf2;border-radius:14px;padding:24px">
      <div style="font-size:17px;font-weight:800">This is for you if</div>
      <div style="margin-top:16px;display:grid;gap:11px;font-size:13.5px;color:#26354d">
        <div style="display:flex;gap:10px"><span style="flex:none;width:18px;height:18px;border-radius:50%;background:#1d6ef5;color:#fff;font-size:10.5px;display:flex;align-items:center;justify-content:center">✓</span>You are a beginner and the whole internet feels like too much.</div>
        <div style="display:flex;gap:10px"><span style="flex:none;width:18px;height:18px;border-radius:50%;background:#1d6ef5;color:#fff;font-size:10.5px;display:flex;align-items:center;justify-content:center">✓</span>You have no audience and do not want to wait until you do.</div>
        <div style="display:flex;gap:10px"><span style="flex:none;width:18px;height:18px;border-radius:50%;background:#1d6ef5;color:#fff;font-size:10.5px;display:flex;align-items:center;justify-content:center">✓</span>You want something cheap, short, and you can act on this week.</div>
      </div>
    </div>
    <div style="background:#fbfcfe;border:1px solid #e6eaf2;border-radius:14px;padding:24px">
      <div style="font-size:17px;font-weight:800">This is not for you if</div>
      <div style="margin-top:16px;display:grid;gap:11px;font-size:13.5px;color:#26354d">
        <div style="display:flex;gap:10px"><span style="flex:none;width:18px;height:18px;border-radius:50%;background:#fde8e7;color:#d64b45;font-size:10.5px;font-weight:700;display:flex;align-items:center;justify-content:center">✕</span>Anyone looking for get-rich-quick promises or income guarantees.</div>
        <div style="display:flex;gap:10px"><span style="flex:none;width:18px;height:18px;border-radius:50%;background:#fde8e7;color:#d64b45;font-size:10.5px;font-weight:700;display:flex;align-items:center;justify-content:center">✕</span>Anyone who wants a done-for-you business handed to them.</div>
        <div style="display:flex;gap:10px"><span style="flex:none;width:18px;height:18px;border-radius:50%;background:#fde8e7;color:#d64b45;font-size:10.5px;font-weight:700;display:flex;align-items:center;justify-content:center">✕</span>Anyone who already sells digital products and needs advanced scaling.</div>
      </div>
    </div>
    <div style="background:#0d1522;border-radius:14px;padding:26px;color:#fff;display:flex;flex-direction:column">
      <div style="font-size:11px;font-weight:800;letter-spacing:0.18em;color:#8fa6c9">ONE-TIME</div>
      <div style="font-size:23px;font-weight:900;letter-spacing:-0.025em;margin-top:10px;line-height:1.2">Starting shouldn't cost $1,995.</div>
      <p style="margin:12px 0 0;font-size:13.5px;line-height:1.5;color:#b9c6da">Your First $1 Online is $5, once. You get the kit. You keep it. No subscription, no fake countdown, no “only 3 spots left.”</p>
      <div style="flex:1;min-height:14px"></div>
      <a href="#kit" style="display:block;text-align:center;background:#1d6ef5;color:#fff;font-size:15px;font-weight:700;padding:15px;border-radius:10px" style-hover="background:#155cd6;color:#fff">Get Your First $1 Online →</a>
    </div>
  </div>

  <div style="max-width:720px;margin:0 auto;padding:56px 28px 0;text-align:center">
    <h3 style="margin:0;font-size:30px;font-weight:900;letter-spacing:-0.03em">Five dollars. One first attempt.</h3>
    <p style="margin:10px 0 0;font-size:14.5px;line-height:1.55;color:#61708c;text-wrap:pretty">If you have been circling this for months, start smaller than the courses told you to. Make one simple product. Try to sell it. Learn from that.</p>
    <a href="#kit" style="display:inline-block;margin-top:22px;background:#1d6ef5;color:#fff;font-size:15.5px;font-weight:700;padding:15px 26px;border-radius:11px;box-shadow:0 10px 24px rgba(29,110,245,0.28)" style-hover="background:#155cd6;color:#fff">Get the $5 Kit →</a>
  </div>

  <footer style="max-width:1180px;margin:0 auto;padding:44px 28px 34px;display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;font-size:12.5px;color:#8b98af">
    <div style="font-weight:700;color:#4a5a75">First Dollar Co.</div>
    <div>A calmer path to your first $1 online.</div>
  </footer>
</div>

</x-dc>
<script type="text/x-dc" data-dc-script data-props="{
  &quot;showComparison&quot;: { &quot;editor&quot;: &quot;boolean&quot;, &quot;default&quot;: true, &quot;tsType&quot;: &quot;boolean&quot;, &quot;section&quot;: &quot;Sections&quot; },
  &quot;showFreeCourse&quot;: { &quot;editor&quot;: &quot;boolean&quot;, &quot;default&quot;: true, &quot;tsType&quot;: &quot;boolean&quot;, &quot;section&quot;: &quot;Sections&quot; },
  &quot;showSocialProof&quot;: { &quot;editor&quot;: &quot;boolean&quot;, &quot;default&quot;: true, &quot;tsType&quot;: &quot;boolean&quot;, &quot;section&quot;: &quot;Sections&quot; }
}">
class Component extends DCLogic {
  state = { vw: typeof window !== 'undefined' ? window.innerWidth : 1440 };
  textRef = React.createRef();
  componentDidMount() {
    this._ro = new ResizeObserver(() => { const el = this.textRef.current; if (el) this.setState({ textH: el.offsetHeight }); });
    if (this.textRef.current) this._ro.observe(this.textRef.current);
    this._onR = () => this.setState({ vw: window.innerWidth });
    window.addEventListener('resize', this._onR);
    this._onR();
  }
  componentWillUnmount() { window.removeEventListener('resize', this._onR); if (this._ro) this._ro.disconnect(); }
  renderVals() {
    const W = this.state.vw;
    const imgW = Math.min(W * (W < 1100 ? 0.57 : 0.6), 1300);
    const imgH = imgW / 1.8;
    const containerLeft = Math.max(0, (W - 1180) / 2) + 28;
    const textMax = Math.min(560, W - imgW - containerLeft - 12);
    const wide = textMax >= 290;
    const textH = this.state.textH || 0;
    return {
      heroWide: wide,
      heroNarrow: !wide,
      heroImgW: imgW + 'px',
      heroMinH: wide ? (Math.max(imgH, textH) + 84) + 'px' : 'auto',
      heroImgTop: (92 + Math.max(0, (textH - imgH) / 2)) + 'px',
      textRef: this.textRef,
      heroTextMax: wide ? textMax + 'px' : '640px',
      showComparison: this.props.showComparison ?? true,
      showFreeCourse: this.props.showFreeCourse ?? true,
      showSocialProof: this.props.showSocialProof ?? true,
    };
  }
}
</script>
</body>
</html>
